# ---- Админка ----
# Логин/пароль создаются при первом старте контейнера.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=
# Поставьте 1, чтобы при каждом старте пароль сбрасывался на значение выше.
DJANGO_SUPERUSER_FORCE_PASSWORD=0

# ---- Django ----
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Kyiv
DJANGO_LANGUAGE_CODE=ru-ru

# ---- PostgreSQL ----
POSTGRES_DB=linkedin_jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Порт админки на хосте ----
WEB_PORT=8000

# ---- Парсер (значения по умолчанию, переопределяются в каждом запросе) ----
SCRAPER_DEFAULT_TIMEOUT=20
SCRAPER_DEFAULT_DELAY=2.0
SCRAPER_MAX_RETRIES=3
JOBS_LOG_LEVEL=INFO
